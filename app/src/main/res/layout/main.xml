<?xml version="1.0" encoding="utf-8"?>
<!-- R-30: one screen, one scroll, framework widgets only. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/restricted_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="@string/restricted_hint"
            android:visibility="gone" />

        <Switch
            android:id="@+id/active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/switch_active"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/auto_with_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_with_apps" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/apps_header"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/add_tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/add_tile" />

        <TextView
            android:id="@+id/add_tile_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/add_tile_hint"
            android:visibility="gone" />

        <Button
            android:id="@+id/dump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/debug_dump"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
